/* ============================================
   Sticky Notes — полнофункциональные стикеры
   Использование: > [!sticky] или > [!sticky|-розовый]
   Модификаторы: -yellow, -pink, -blue, -green, -white, -purple, -tilt-left, -tilt-right, -pin
   ============================================ */

/* Базовый стиль */
.callout[data-callout="sticky"] {
    --bg: #fff9c4;
    background: var(--bg) !important;
    border: none !important;
    border-radius: 3px !important;
    padding: 14px 18px !important;
    margin: 12px 0 !important;
    box-shadow: 3px 4px 8px rgba(0, 0, 0, 0.25) !important;
    font-family: "Comic Sans MS", "Segoe Script", "Dancing Script", cursive, sans-serif !important;
    transform: rotate(-1deg);
    max-width: 350px;
    position: relative !important;
}

/* Контент внутри */
.callout[data-callout="sticky"] .callout-content {
    color: #333 !important;
}

.callout[data-callout="sticky"] .callout-content p {
    margin: 4px 0 !important;
}

/* Заголовок */
.callout[data-callout="sticky"] .callout-title-inner {
    color: #333 !important;
    font-weight: bold !important;
    font-size: 1.1em !important;
}

.callout[data-callout="sticky"] .callout-icon {
    display: none !important;
}

/* Чекбоксы внутри стикера */
.callout[data-callout="sticky"] .task-list-item {
    list-style: none !important;
    margin-left: 0 !important;
    padding-left: 0 !important;
}

.callout[data-callout="sticky"] .task-list-item-checkbox {
    margin-right: 6px !important;
    accent-color: #ff9800 !important;
}

/* Картинки внутри стикера */
.callout[data-callout="sticky"] img {
    border-radius: 3px !important;
    margin: 6px 0 !important;
    max-width: 100% !important;
}

/* Ссылки */
.callout[data-callout="sticky"] a {
    color: #e65100 !important;
    text-decoration: underline !important;
}

/* Код */
.callout[data-callout="sticky"] code {
    background: rgba(0,0,0,0.08) !important;
    border-radius: 2px !important;
    padding: 1px 4px !important;
}

/* ============================================
   ЦВЕТА
   ============================================ */

.callout[data-callout="sticky"][data-callout*="-yellow"] {
    --bg: #fff9c4;
}

.callout[data-callout="sticky"][data-callout*="-pink"] {
    --bg: #f8bbd0;
}

.callout[data-callout="sticky"][data-callout*="-blue"] {
    --bg: #bbdefb;
}

.callout[data-callout="sticky"][data-callout*="-green"] {
    --bg: #c8e6c9;
}

.callout[data-callout="sticky"][data-callout*="-purple"] {
    --bg: #e1bee7;
}

.callout[data-callout="sticky"][data-callout*="-white"] {
    --bg: #ffffff;
}

/* ============================================
   ПОВОРОТЫ
   ============================================ */

.callout[data-callout="sticky"][data-callout*="-tilt-left"] {
    transform: rotate(-2deg);
}

.callout[data-callout="sticky"][data-callout*="-tilt-right"] {
    transform: rotate(1.5deg);
}

.callout[data-callout="sticky"][data-callout*="-tilt-none"] {
    transform: rotate(0deg);
}

/* ============================================
   БУЛАВКА
   ============================================ */

.callout[data-callout="sticky"][data-callout*="-pin"]::before {
    content: "📌";
    position: absolute;
    top: -12px;
    left: 50%;
    transform: translateX(-50%);
    font-size: 18px;
    z-index: 5;
    text-shadow: 0 1px 2px rgba(0,0,0,0.2);
}

.callout[data-callout="sticky"][data-callout*="-pin"] {
    margin-top: 20px !important;
}

/* ============================================
   КНОПКА-СКРЕПКА (альтернатива булавке)
   ============================================ */

.callout[data-callout="sticky"][data-callout*="-clip"]::before {
    content: "📎";
    position: absolute;
    top: -8px;
    right: 15px;
    font-size: 20px;
    z-index: 5;
    text-shadow: 0 1px 2px rgba(0,0,0,0.2);
}

.callout[data-callout="sticky"][data-callout*="-clip"] {
    margin-top: 16px !important;
}

/* ============================================
   ЛИНОВАННАЯ БУМАГА
   ============================================ */

.callout[data-callout="sticky"][data-callout*="-lined"] {
    background-image: repeating-linear-gradient(
        transparent,
        transparent 1.5em,
        rgba(0, 0, 0, 0.07) 1.5em,
        rgba(0, 0, 0, 0.07) 1.55em
    ) !important;
}

.callout[data-callout="sticky"][data-callout*="-lined"] .callout-content {
    line-height: 1.55em;
}

/* ============================================
   ТЕКСТУРА БУМАГИ
   ============================================ */

.callout[data-callout="sticky"][data-callout*="-texture"] {
    background-image: url("data:image/svg+xml,%3Csvg width='40' height='40' xmlns='http://www.w3.org/2000/svg'%3E%3Ccircle cx='20' cy='20' r='0.4' fill='rgba(0,0,0,0.04)'/%3E%3C/svg%3E") !important;
    background-size: 40px 40px;
}

/* ============================================
   ПРОЗРАЧНЫЙ ФОН
   ============================================ */

.callout[data-callout="sticky"][data-callout*="-transparent"] {
    --bg: transparent;
    box-shadow: none !important;
    border-left: 3px solid #ffcc80 !important;
    border-radius: 0 !important;
}

/* ============================================
   ШИРИНА
   ============================================ */

.callout[data-callout="sticky"][data-callout*="-w-small"] {
    max-width: 250px;
}

.callout[data-callout="sticky"][data-callout*="-w-medium"] {
    max-width: 350px;
}

.callout[data-callout="sticky"][data-callout*="-w-large"] {
    max-width: 500px;
}

/* ============================================
   ПЛАВАЮЩИЕ (обтекание текстом)
   ============================================ */

.callout[data-callout="sticky"][data-callout*="-left"] {
    float: left;
    margin-right: 1em;
    margin-bottom: 0.5rem;
}

.callout[data-callout="sticky"][data-callout*="-right"] {
    float: right;
    margin-left: 1em;
    margin-bottom: 0.5rem;
  }
